APP_ENV=development
APP_TIMEZONE=Asia/Kolkata
APP_BASE_PATH=/astropop/public
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=astropop
DB_USER=root
DB_PASSWORD=
VEDIC_API_BASE_URL=https://api.vedicastroapi.com/v3-json
VEDIC_API_KEY=
VEDIC_API_TIMEOUT=15
VEDIC_API_CONNECT_TIMEOUT=5
# Server-side OpenAI configuration for ASTROPOP AI Chat.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_API_TIMEOUT=30
OPENAI_API_CONNECT_TIMEOUT=10
# ASTROPOP customer price per successful AI response.
AI_CHAT_COINS_PER_MESSAGE=1
